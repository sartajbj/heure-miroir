# ==========================================================
# Heure Miroir Plus
# Git ignore rules
# ==========================================================


# Node dependencies
node_modules/


# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# Environment / secrets
.env
.env.*
!.env.example


# Operating system files
.DS_Store
Thumbs.db
Desktop.ini


# Editor / IDE files
.vscode/
.idea/
*.swp
*.swo
*~


# Temporary files
*.tmp
*.temp
.cache/


# Test / coverage output
coverage/


# Local build/cache directories
dist/
.tmp/


# Cloudflare local development files
.wrangler/


# ==========================================================
# IMPORTANT
# ==========================================================
# Generated heure-miroir-XXhXX.html pages are intentionally
# NOT ignored. They are production SEO pages.
#
# sitemap.xml is also intentionally tracked.
# heures.json and heure-template.html are source files
# and must remain tracked.
